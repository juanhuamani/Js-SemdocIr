# Entorno del experimento.
# Copiar a .env y completar. .env NO se versiona.

# Clave del proveedor. Nunca se escribe en protocol.json: el validador
# rechaza cualquier campo con nombre de credencial, por diseño.
COMMANDCODE_API_KEY=

# Endpoint compatible con la API de OpenAI, hasta /v1.
# Se copia del panel del proveedor; no se adivina.
COMMANDCODE_BASE_URL=

# Tiempo máximo por llamada, en milisegundos.
COMMANDCODE_TIMEOUT_MS=60000

# Opcional. Modelo de reserva cuando la petición no nombra uno; el protocolo
# congelado tiene prioridad. En la corrida real se usa el del protocolo.
COMMANDCODE_MODEL=
