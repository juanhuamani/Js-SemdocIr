{
  "name": "jssemdocir",
  "version": "0.1.0",
  "description": "JS-SemDocIR — AST representations and mock documentation pipeline",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
