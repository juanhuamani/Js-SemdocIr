{
  "name": "jssemdocir",
  "version": "0.1.0",
  "description": "JS-SemDocIR — AST representations and mock documentation pipeline",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test",
    "test:integration": "node --test test/integration/phase2.test.ts",
    "demo": "node src/interfaces/cli.ts",
    "app": "node --env-file-if-exists=.env src/interfaces/http/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:size": "node scripts/check-size.mjs",
    "corpus": "node scripts/fetch-corpus.mjs && node scripts/prepare-corpus.mjs && node scripts/build-material.mjs && node scripts/characterize-corpus.mjs",
    "corpus:sample": "node scripts/sample-rubric.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@babel/parser": "8.0.7"
  },
  "devDependencies": {
    "@babel/types": "8.0.6",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
